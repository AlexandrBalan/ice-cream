<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/styles/confirm.css" />
    <title>Confirmation</title>
  </head>
  <body>
    <div id="main">
      <div id="heading">
        <div>
          <img src="/images/checkmark.svg" alt="A checkmark" />
        </div>
        <h1>Thank You for Your Order!</h1>
        <span>Your ice cream order has been confirmed</span>
      </div>
      <div id="body">
        <h2>Personal Information</h2>
        <div>
          <p>Name: <%= order.name %></p>
        </div>
        <div>
          <p>Email: <%= order.email %></p>
        </div>
      </div>

      <p>Flavor: <%= order.flavor %></p>
      <p>Cone Type: <%= order.conetype %></p>
      <p>Toppings: <%= order.topping %></p>
      <p>Comment: <%= order.comments %></p>
    </div>
  </body>
</html>
